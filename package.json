{
  "name": "@athenanetworks/pracbill-mcp",
  "version": "1.0.0",
  "description": "MCP Server for the Pracbill Billing API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pracbill-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
