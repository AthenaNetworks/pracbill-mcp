    "parse-swagger": "tsx src/swagger-parser.ts"
  },
  "keywords": ["mcp", "pracbill", "billing", "api"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
